[Unit]
Description=Warehouse Management API Service (FastAPI)
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/warehouse-api
EnvironmentFile=/opt/warehouse-api/.env
ExecStart=/opt/warehouse-api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3
KillSignal=SIGQUIT
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
